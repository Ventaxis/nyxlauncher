{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NyxLauncher",
  "version": "0.4.0",
  "identifier": "corp.ventaxis.nyxlauncher",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NyxLauncher",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ventaxis Corp",
    "copyright": "© 2026 Ventaxis Corp. Все права защищены.",
    "category": "Game",
    "homepage": "https://github.com/Ventaxis/nyxlauncher",
    "shortDescription": "Библиотека игр, учёт времени и достижения — локально, без сети",
    "longDescription": "NyxLauncher собирает установленные игры в одну библиотеку, считает игровое время, ведёт историю сессий и выдаёт достижения. Работает локально: без учётной записи, магазина и телеметрии.",
    "license": "LicenseRef-Proprietary",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}
