{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NyxLauncher",
  "version": "0.2.0",
  "identifier": "corp.ventaxis.nyxlauncher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NyxLauncher",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
