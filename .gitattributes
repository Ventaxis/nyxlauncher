# Нормализация переводов строк: в репозитории LF, в рабочей копии Windows — CRLF
* text=auto

*.rs        text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.conf      text eol=lf

# Скрипты и bat-файлы Windows
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Бинарные файлы
*.png       binary
*.ico       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.exe       binary
*.dll       binary
*.zip       binary

# Языковая статистика на GitHub
*.rs        linguist-language=Rust
ui/dist/**  linguist-generated=true
package-lock.json linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
